# Copy to .env and fill in. Never commit .env.

# --- LLM ---------------------------------------------------------------
# "anthropic" (first-party API) for local runs, "vertex" for Claude on GCP.
LLM_PROVIDER=anthropic   # anthropic | vertex | gemini
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
# Only used when LLM_PROVIDER=vertex (auth via Application Default Credentials).
GCP_PROJECT_ID=
GCP_REGION=global

# --- Gemini (optional, for the model benchmark) ------------------------
# Key from https://aistudio.google.com/apikey. The free tier may use prompts
# to improve Google models; use a billed project or Vertex AI for real data.
GEMINI_API_KEY=
# Pro models need a billed project; the free tier only serves Flash.
GEMINI_MODEL=gemini-3.1-pro-preview
# true = Gemini on Vertex AI with Application Default Credentials (no key).
GEMINI_USE_VERTEX=false

# --- Retrieval ---------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-large
SHORTLIST_SIZE=6
TOP_K=3

# --- API ---------------------------------------------------------------
# JSON list. Leave empty locally to disable auth (refused in production).
API_KEYS=[]
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=10
ENVIRONMENT=local
LOG_LEVEL=INFO
